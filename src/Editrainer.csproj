<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Editrainer</AssemblyName>
    <Version>2.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('..\Assets\app.ico')">..\Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
    <AppHostDotNetSearch>Global</AppHostDotNetSearch>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PKHeX.Core"><HintPath>../lib/PKHeX.Core.dll</HintPath></Reference>
    <Reference Include="PKHeX.Core.AutoMod"><HintPath>../lib/PKHeX.Core.AutoMod.dll</HintPath></Reference>
  </ItemGroup>
</Project>
